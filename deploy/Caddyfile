# Caddy as the load balancer in front of three AIRTRUTH replicas (deploy/compose.yaml).
# Plain HTTP on :8080 locally; for TLS behind a domain, replace ":8080" with your hostname.
{
	admin off
	auto_https off
}

:8080 {
	reverse_proxy app1:8080 app2:8080 app3:8080 {
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
		lb_retries 2

		health_uri /healthz
		health_interval 5s
		health_timeout 2s
		health_status 2xx

		fail_duration 30s
		max_fails 2
		unhealthy_status 5xx
		unhealthy_latency 5s

		transport http {
			dial_timeout 2s
			keepalive 30s
		}
	}
	header -Server
	log {
		output stdout
		format json
	}
}
