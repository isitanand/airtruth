# Copy to engine/.env (gitignored) for `python -m airtruth_engine serve`; in containers set these as env vars / secrets.
# Every value below is the default unless noted. Never commit real keys.

# ---- optional LLM synthesis (deterministic statutory & telemetry packets always run without keys) ----
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=                    # alternative provider (pip install "airtruth-engine[llm]")
# AIRTRUTH_LLM_MODEL=claude-haiku-4-5-20251001
# LLM_DAILY_LIMIT=500/d                 # model calls per UTC day across instances

# ---- serving ----
# PORT=8787                             # Cloud Run sets 8080; --port overrides
# SITE_URL=https://airtruth.example     # replaces __SITE_URL__ in prerendered metadata; unset = request origin
# LOG_FORMAT=                           # json | text | unset
# GRACEFUL_SHUTDOWN_SECONDS=8
# KEEP_ALIVE_SECONDS=75
# SERVED_BY=

# ---- behind a load balancer ----
# REDIS_URL=                            # redis:// or rediss:// for shared sessions and rate limits
# TRUSTED_PROXY_HOPS=1
# FORWARDED_ALLOW_IPS=127.0.0.1

# ---- sessions & WAF ----
# WAF_RATE_LIMITS=on
# AIRTRUTH_DEV_SEED=airtruth-dev-2026   # derives sandbox publishable/secret keys
